#!/usr/bin/env python3
"""Shortcut Coach: learn Omarchy shortcuts a few at a time.

  shortcut-coach list [--all] [--json]   up next (--all: every section)
  shortcut-coach add KEYS TITLE [WHY]    add your own shortcut to the front of the queue
  shortcut-coach done ID                 got it: mastered for good
  shortcut-coach undo ID                 put a mastered one back
  shortcut-coach later ID                not sure yet: practice it with spaced check-ins
  shortcut-coach checkin ID pass|fail|skip
                                         answer a check-in (pass moves it a step along,
                                         fail steps it back, skip asks again soon)
  shortcut-coach due [--json]            the practice shortcut due for a check-in, if any
  shortcut-coach fav ID / unfav ID       star or unstar a shortcut (your favorites list)
  shortcut-coach pause on|off            pause or resume check-ins
  shortcut-coach intro-seen              don't explain practice again
  shortcut-coach setup-seen              don't show the practice-desktop card again
  shortcut-coach welcome                 show the first-time cards again (keeps progress)
  shortcut-coach remove ID               delete one you added
  shortcut-coach batch N                 how many to show in up next (default 6)
  shortcut-coach done-section N          check off a whole section (1-5; 0 = added for you)
  shortcut-coach reset --yes             start over (keeps lessons you added;
                                         the old progress is kept in a .bak file)
  shortcut-coach apply JSON              run several commands in order, e.g. '[["done","close"]]'

Lessons are grouped into sections, Essentials first. "Up next" walks them in
order; any lesson can be checked off from its section.

Practice is expanding spaced retrieval, after Pimsleur's graduated interval
recall (1967) and later work on spacing (Karpicke & Roediger 2007, Cepeda et
al. 2008). A shortcut you're unsure of: try it once right away, then quick
check-ins after 10 minutes, 1 hour, 1 day (a night's sleep in between), 4
days, 2 weeks and 6 weeks. Each gap is about 3-4x the last. Pass the last
one and it's locked in. A miss ("Show me") retries in 10 minutes and steps
back (two steps from 2 weeks on); three misses mark it tricky. Check-ins
come at least 15 minutes apart, at most 8 a day.

Progress lives in ~/.local/state/omarchy-shortcut-coach.json. Each lesson
shows the keys from your live Hyprland bindings, so rebound shortcuts show
your keys.
"""
import datetime, fcntl, json, os, re, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
# SHORTCUT_COACH_STATE points tests at a scratch file, never your progress.
STATE = os.environ.get("SHORTCUT_COACH_STATE") or os.path.expanduser("~/.local/state/omarchy-shortcut-coach.json")
# Keys written as a family or a gesture keep the curriculum's wording.
FAMILY = re.compile(r"ARROWS|1-9|/|DRAG|SCROLL")
# Minutes until each check-in: 10m, 1h, 1d, 4d, 2w, 6w. Expanding by ~3-4x,
# near the best gap for each retention target (Cepeda et al. 2008); the 1d
# step puts a night's sleep before the third check (Walker et al. 2002).
STEPS = [10, 60, 1440, 5760, 20160, 60480]
RETRY_MINUTES = 10   # after "show me"
SKIP_MINUTES = 15    # check-in ignored or dismissed: no step change
BIG_STEP_BACK_FROM = 4  # a miss at 2 weeks or later steps back two
TRICKY_LAPSES = 3
DAILY_CAP = 8        # check-ins shown per day


def now():
    return datetime.datetime.now().replace(microsecond=0)


def load_state():
    try:
        with open(STATE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    s.setdefault("mastered", {})
    s.setdefault("custom", [])
    s.setdefault("batch", 6)
    s.setdefault("practice", {})
    s.setdefault("paused", False)
    s.setdefault("introSeen", False)
    s.setdefault("today", {"date": "", "count": 0})
    s.setdefault("favorites", [])
    s.setdefault("setupSeen", False)
    s.pop("snoozed", None)
    return s


def backup_state():
    """Keep a copy of yesterday's progress (and the one before a reset)."""
    backup = STATE + ".bak"
    try:
        if not os.path.exists(STATE):
            return
        if os.path.exists(backup) and now().timestamp() - os.path.getmtime(backup) < 86400:
            return
        with open(STATE) as src, open(backup, "w") as dst:
            dst.write(src.read())
    except OSError:
        pass


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    backup_state()
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE), prefix=".shortcut-coach.")
    with os.fdopen(fd, "w") as f:
        json.dump(s, f, indent=2)
        f.write("\n")
    os.replace(tmp, STATE)


def live_bindings():
    """Map action description -> keys, from Omarchy's own keybinding list."""
    try:
        out = subprocess.run(["omarchy-menu-keybindings", "--print"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = {}
    for line in out.splitlines():
        if "→" not in line:
            continue
        keys, action = (part.strip() for part in line.split("→", 1))
        keys = re.sub(r"\s+", " ", keys)
        # Prefer a keyboard binding over a mouse one for the same action.
        if action not in found or ("mouse" in found[action].lower() and "mouse" not in keys.lower()):
            found[action] = keys
    return found or None


def curriculum():
    with open(os.path.join(HERE, "curriculum.json")) as f:
        return json.load(f)


def prose_keys(keys):
    """SUPER SHIFT + 1-9 -> Super + Shift + 1-9, for reading in a sentence."""
    parts = [p for p in re.split(r"[\s+]+", keys) if p]
    return " + ".join(p.capitalize() if p.isalpha() and len(p) > 1 else p for p in parts)


def humanize(delta):
    minutes = delta.total_seconds() / 60
    if minutes < 60:
        return f"{max(1, round(minutes))}m"
    if minutes < 36 * 60:
        return f"{round(minutes / 60)}h"
    return f"{round(minutes / 1440)}d"


def lessons(s, cur):
    live = live_bindings()
    names = cur["levels"]
    items = [dict(c, custom=True, level=0, section="Added for you") for c in s["custom"]]
    for c in cur["lessons"]:
        c = dict(c)
        # Menu lessons are reached by clicking, not a binding.
        if live is not None and not c.get("menu"):
            if c["action"] not in live:
                continue  # not bound on this machine
            if not FAMILY.search(c["keys"]):
                c["keys"] = live[c["action"]]
        # Variants taught in the same lesson ("add Alt to stay put") name
        # their keys as {name} in the tip and the explanation.
        for name, (action, fallback) in c.pop("variants", {}).items():
            keys = fallback if live is None or action not in live or FAMILY.search(fallback) else live[action]
            for field in ("why", "more"):
                if c.get(field):
                    c[field] = c[field].replace("{" + name + "}", prose_keys(keys))
        items.append(dict(c, custom=False, section=names.get(str(c["level"]), "")))
    # Longer explanations name other shortcuts as {lesson-id}; fill in the
    # keys this machine actually uses.
    # A shortcut this machine doesn't have falls back to the curriculum keys.
    keys_by_id = {l["id"]: prose_keys(l["keys"]) for l in cur["lessons"]}
    keys_by_id.update({i["id"]: prose_keys(i["keys"]) for i in items})
    for item in items:
        if item.get("more"):
            item["more"] = re.sub(r"\{([a-z0-9-]+)\}",
                                  lambda m: keys_by_id.get(m.group(1), m.group(0)), item["more"])
    t = now()
    favorites = set(s["favorites"])
    for item in items:
        item["favorite"] = item["id"] in favorites
        item["mastered"] = s["mastered"].get(item["id"])
        p = s["practice"].get(item["id"]) if not item["mastered"] else None
        due = datetime.datetime.fromisoformat(p["due"]) if p else None
        item["practicing"] = bool(p)
        item["stage"] = p["stage"] if p else 0
        item["lapses"] = p.get("lapses", 0) if p else 0
        item["tricky"] = item["lapses"] >= TRICKY_LAPSES
        item["steps"] = len(STEPS)
        item["checkIn"] = bool(p) and due <= t
        item["backIn"] = humanize(due - t) if p and due > t else ""
    return items


def setup_keys():
    """Keys for the practice-desktop card, as this machine has them."""
    live = live_bindings() or {}
    return {
        "desktop": prose_keys(live.get("Switch to workspace 9", "SUPER + 9")),
        "terminal": prose_keys(live.get("Terminal", "SUPER + RETURN")).replace("Return", "Enter"),
    }


def progress(s):
    """Lessons grouped into sections. Nothing is locked: "up next" walks the
    sections in order, check-ins that are due come first, and shortcuts in
    practice step aside until their next check-in."""
    cur = curriculum()
    items = lessons(s, cur)
    sections = []
    for level in sorted({i["level"] for i in items if i["level"] > 0}):
        members = [i for i in items if i["level"] == level]
        sections.append({
            "level": level,
            "name": cur["levels"].get(str(level), f"Section {level}"),
            "icon": cur.get("icons", {}).get(str(level), ""),
            "done": sum(1 for i in members if i["mastered"]),
            "total": len(members),
            "items": members,
        })
    added = [i for i in items if i["custom"]]
    if added:
        sections.insert(0, {"level": 0, "name": "Added for you", "items": added,
                            "done": sum(1 for i in added if i["mastered"]), "total": len(added)})
    by_id = {i["id"]: i for i in items}
    favorites = [by_id[f] for f in s["favorites"] if f in by_id]
    ordered = [i for sec in sections for i in sec["items"] if not i["mastered"]]
    up_next = [i for i in ordered if i["checkIn"]] + [i for i in ordered if not i["practicing"]]
    mastered = sum(1 for i in items if i["mastered"])
    return {
        "batch": s["batch"],
        "upNext": up_next,
        "favorites": favorites,
        "sections": sections,
        "mastered": mastered,
        "total": len(items),
        "complete": mastered == len(items) and len(items) > 0,
        "practicing": sum(1 for i in items if i["practicing"]),
        "checkIns": sum(1 for i in items if i["checkIn"]),
        "paused": s["paused"],
        "introSeen": s["introSeen"],
        "setupSeen": s["setupSeen"],
        "setup": setup_keys(),
        "steps": STEPS,
    }


def schedule(s, lesson_id, minutes, stage):
    due = now() + datetime.timedelta(minutes=minutes)
    lapses = s["practice"].get(lesson_id, {}).get("lapses", 0)
    s["practice"][lesson_id] = {"stage": stage, "due": due.isoformat(), "lapses": lapses}
    return humanize(due - now())


def shown_today(s):
    today = datetime.date.today().isoformat()
    if s["today"].get("date") != today:
        s["today"] = {"date": today, "count": 0}
    return s["today"]["count"]


def slug(text):
    return "my-" + (re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "shortcut")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    s = load_state()

    if cmd == "apply" and args:
        # Several answers from the panel, saved in order.
        for step in json.loads(args[0]):
            main([str(a) for a in step])
        return 0

    if cmd == "list":
        p = progress(s)
        if "--json" in args:
            print(json.dumps(p))
            return 0
        if "--all" in args:
            for sec in p["sections"]:
                print(f"\n{sec['name']} ({sec['done']}/{sec['total']})")
                for i in sec["items"]:
                    mark = "x" if i["mastered"] else ("~" if i["practicing"] else " ")
                    note = f"  step {i['stage']}/{i['steps']}, next check {i['backIn'] or 'now'}" if i["practicing"] else ""
                    print(f"  [{mark}] {i['keys']:<26} {i['title']}  ({i['id']}){note}")
        else:
            print("Up next:")
            for i in p["upNext"][: p["batch"]]:
                tag = "  [check-in]" if i["checkIn"] else ""
                print(f"  [ ] {i['keys']:<26} {i['title']}  ({i['id']}){tag}")
        print(f"\n{p['mastered']} of {p['total']} mastered, {p['practicing']} in practice"
              + (" (check-ins paused)" if p["paused"] else ""))
        return 0

    if cmd == "due":
        if s["paused"] or shown_today(s) >= DAILY_CAP:
            item = None
        else:
            due = [i for i in lessons(s, curriculum()) if i["checkIn"]]
            due.sort(key=lambda i: s["practice"][i["id"]]["due"])
            item = due[0] if due else None
        if "--json" in args:
            print(json.dumps(item or {}))
        elif item:
            print(f"{item['id']}: {item['title']} (step {item['stage'] + 1} of {item['steps']})")
        return 0

    if cmd == "add" and len(args) >= 2:
        keys, title = args[0].strip(), args[1].strip()
        why = args[2].strip() if len(args) > 2 else ""
        ids = {c["id"] for c in s["custom"]}
        new_id, n = slug(title), 2
        while new_id in ids:
            new_id, n = f"{slug(title)}-{n}", n + 1
        s["custom"].append({"id": new_id, "keys": keys, "title": title, "why": why,
                            "added": datetime.date.today().isoformat()})
        save_state(s)
        print(new_id)
        return 0

    if cmd == "done" and args:
        s["mastered"][args[0]] = datetime.date.today().isoformat()
        s["practice"].pop(args[0], None)
        save_state(s)
        return 0

    if cmd == "undo" and args:
        s["mastered"].pop(args[0], None)
        s["practice"].pop(args[0], None)
        save_state(s)
        return 0

    if cmd == "later" and args:
        p = s["practice"].get(args[0])
        # Already practicing and unsure again: one step back, ask again soon.
        if p:
            print("back in " + schedule(s, args[0], RETRY_MINUTES, max(0, p["stage"] - 1)))
        else:
            print("back in " + schedule(s, args[0], STEPS[0], 0))
        save_state(s)
        return 0

    if cmd == "checkin" and len(args) == 2 and args[1] in ("pass", "fail", "skip"):
        lesson_id, answer = args
        p = s["practice"].get(lesson_id)
        if not p:
            return 1
        shown_today(s)
        s["today"]["count"] += 1
        if answer == "pass":
            stage = p["stage"] + 1
            if stage >= len(STEPS):
                s["practice"].pop(lesson_id)
                s["mastered"][lesson_id] = datetime.date.today().isoformat()
                print("locked in")
            else:
                print("back in " + schedule(s, lesson_id, STEPS[stage], stage))
        elif answer == "fail":
            back = 2 if p["stage"] >= BIG_STEP_BACK_FROM else 1
            p["lapses"] = p.get("lapses", 0) + 1
            print("back in " + schedule(s, lesson_id, RETRY_MINUTES, max(0, p["stage"] - back)))
        else:
            print("back in " + schedule(s, lesson_id, SKIP_MINUTES, p["stage"]))
        save_state(s)
        return 0

    if cmd == "fav" and args:
        if args[0] not in s["favorites"]:
            s["favorites"].append(args[0])
        save_state(s)
        return 0

    if cmd == "unfav" and args:
        s["favorites"] = [f for f in s["favorites"] if f != args[0]]
        save_state(s)
        return 0

    if cmd == "pause" and args and args[0] in ("on", "off"):
        s["paused"] = args[0] == "on"
        save_state(s)
        return 0

    if cmd == "intro-seen":
        s["introSeen"] = True
        save_state(s)
        return 0

    if cmd == "welcome":
        # Show the first-time cards again; progress stays as it is.
        s["setupSeen"] = False
        s["introSeen"] = False
        save_state(s)
        return 0

    if cmd == "setup-seen":
        s["setupSeen"] = True
        save_state(s)
        return 0

    if cmd == "remove" and args:
        s["custom"] = [c for c in s["custom"] if c["id"] != args[0]]
        s["mastered"].pop(args[0], None)
        s["practice"].pop(args[0], None)
        save_state(s)
        return 0

    if cmd == "batch" and args and args[0].isdigit() and int(args[0]) > 0:
        s["batch"] = int(args[0])
        save_state(s)
        return 0

    if cmd == "done-section" and args and args[0].isdigit():
        today = datetime.date.today().isoformat()
        for sec in progress(s)["sections"]:
            if sec["level"] == int(args[0]):
                for i in sec["items"]:
                    s["mastered"].setdefault(i["id"], today)
                    s["practice"].pop(i["id"], None)
        save_state(s)
        return 0

    if cmd == "reset":
        if "--yes" not in args:
            print("This erases your progress. Run: shortcut-coach reset --yes", file=sys.stderr)
            print(f"(A copy is kept at {STATE}.bak)", file=sys.stderr)
            return 1
        # Always keep the progress being erased.
        try:
            os.replace(STATE, STATE + ".bak")
        except OSError:
            pass
        s["mastered"] = {}
        s["practice"] = {}
        s["introSeen"] = False
        s["setupSeen"] = False
        save_state(s)
        return 0

    print(__doc__.strip(), file=sys.stderr)
    return 1


def locked_main(argv):
    """One writer at a time: the panel, the check-in card and you."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return main(argv)


if __name__ == "__main__":
    sys.exit(locked_main(sys.argv[1:]))
